APP_TITLE=GreenFund
APP_DESCRIPTION=Сбор средств на экологические инициативы
DATABASE_URL=sqlite+aiosqlite:///./greenfund.db
# Замените случайной строкой: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET=replace-with-your-random-secret
# Для создания администратора раскомментируйте оба значения.
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Только для Google Sheets. Остальные функции доступны без этих параметров.
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=
EMAIL=
